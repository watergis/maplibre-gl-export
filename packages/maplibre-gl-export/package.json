{
	"name": "@watergis/maplibre-gl-export",
	"version": "6.0.0",
	"description": "This module adds control which can export PDF and images.",
	"type": "module",
	"main": "dist/maplibre-gl-export.umd.js",
	"types": "./dist/types/index.d.ts",
	"module": "dist/maplibre-gl-export.es.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/maplibre-gl-export.es.js",
			"require": "./dist/maplibre-gl-export.umd.js"
		},
		"./dist/maplibre-gl-export.css": {
			"import": "./dist/maplibre-gl-export.css",
			"require": "./dist/maplibre-gl-export.css"
		},
		"./dist/maplibre-gl-export.min.css": {
			"import": "./dist/maplibre-gl-export.min.css",
			"require": "./dist/maplibre-gl-export.min.css"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"dev": "vite",
		"build": "npm run build:js",
		"build:js": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"deploy": "gh-pages -d dist -m 'deploy to gh-pages'"
	},
	"keywords": [
		"mapbox",
		"mapbox-gl-js",
		"export",
		"image",
		"pdf"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watergis/maplibre-gl-export.git"
	},
	"author": "Jin IGARASHI",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/watergis/maplibre-gl-export/issues"
	},
	"homepage": "https://github.com/watergis/maplibre-gl-export/tree/main/packages/maplibre-gl-export#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/api-extractor": "^7.59.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@watergis/export-ui": "workspace:^",
		"@watergis/maplibre2svg": "workspace:^",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.7.0",
		"lightningcss": "^1.33.0",
		"mapbox-gl": "^3.26.0",
		"maplibre-gl": "^6.0.0",
		"path": "^0.12.7",
		"pmtiles": "^4.4.1",
		"postcss": "^8.5.21",
		"prettier": "^3.9.6",
		"sass": "^1.101.6",
		"sass-loader": "^17.0.0",
		"svelte": "^5.57.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"svg2pdf.js": "^2.8.1"
	},
	"peerDependencies": {
		"maplibre-gl": "^5.21.1 || >=6.0.0-0 <7.0.0"
	}
}
