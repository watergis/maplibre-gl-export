{
	"name": "@watergis/mapbox-gl-export",
	"version": "5.0.0",
	"description": "This module adds control which can export PDF and images.",
	"type": "module",
	"main": "dist/mapbox-gl-export.umd.js",
	"types": "./dist/types/index.d.ts",
	"module": "dist/mapbox-gl-export.es.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/mapbox-gl-export.es.js",
			"require": "./dist/mapbox-gl-export.umd.js"
		},
		"./dist/mapbox-gl-export.css": {
			"import": "./dist/mapbox-gl-export.css",
			"require": "./dist/mapbox-gl-export.css"
		},
		"./dist/mapbox-gl-export.min.css": {
			"import": "./dist/mapbox-gl-export.min.css",
			"require": "./dist/mapbox-gl-export.min.css"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"dev": "vite",
		"build": "npm run build:js && npm run build:css",
		"build:js": "tsc && vite build",
		"build:css": "node -e \"const fs = require('fs'); for (const ext of ['css', 'min.css']) fs.copyFileSync(require.resolve('@watergis/maplibre-gl-export/dist/maplibre-gl-export.' + ext), 'dist/mapbox-gl-export.' + ext)\"",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"keywords": [
		"mapbox",
		"mapbox-gl-js",
		"export",
		"image",
		"pdf"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watergis/maplibre-gl-export.git"
	},
	"author": "Jin IGARASHI",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/watergis/maplibre-gl-export/issues"
	},
	"homepage": "https://github.com/watergis/maplibre-gl-export#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@watergis/maplibre-gl-export": "workspace:^",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.7.0",
		"mapbox-gl": "^3.26.0",
		"maplibre-gl": "^6.0.0",
		"path": "^0.12.7",
		"postcss": "^8.5.21",
		"prettier": "^3.9.6",
		"sass": "^1.101.6",
		"sass-loader": "^17.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5"
	},
	"peerDependencies": {
		"mapbox-gl": "^3.0.0"
	}
}
